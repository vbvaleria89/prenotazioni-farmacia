# Copiare i nomi su Netlify → Site configuration → Environment variables.
# Non mettere valori veri in git. Non inventare FIREBASE_SERVICE_ACCOUNT.

# Obbligatoria per inviare la ricevuta.
RESEND_API_KEY=

# Opzionali: questi sono i default già usati dal codice.
MAIL_FROM=Farmacia San Ciro <prenotazioni@farmaciasanciro.net>
MAIL_REPLY_TO=farmaciasanciro@gmail.com

# JSON del service account (una riga) oppure base64 del JSON.
# In alternativa, lasciare vuoto e usare i tre pezzi sotto.
FIREBASE_SERVICE_ACCOUNT=

# FIREBASE_PROJECT_ID=farmacia-san-ciro-prenota
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@farmacia-san-ciro-prenota.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Calendar lato server (OAuth offline dell'account farmacia).
# GOOGLE_OAUTH_CLIENT_ID=444833221252-pivii37uqhrshlhtfq4a5i83kl5efef7.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=...@group.calendar.google.com
# GOOGLE_CALENDAR_ACCOUNT=farmaciasanciro.servizi@gmail.com
# GCAL_OAUTH_REDIRECT_URI=https://farmacia-san-ciro-prenota.vercel.app/api/gcal-oauth-callback
# Protegge /api/gcal-reconcile (Vercel Cron invia Authorization: Bearer CRON_SECRET).
CRON_SECRET=
